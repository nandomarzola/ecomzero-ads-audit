# App
PORT=4000
NODE_ENV=development
JWT_SECRET=
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
WORKERS_ENABLED=true

# Database
DATABASE_URL=postgresql://ads_audit:ads_audit@localhost:5433/ecomzero_ads_audit

# Redis (BullMQ) — Sprint 3
REDIS_URL=redis://localhost:6379

# Shopee
SHOPEE_PARTNER_ID=2036419
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URL=https://<definir-depois>.onrender.com/api/shopee/callback
SHOPEE_LIST_PAGE_SIZE=100
SHOPEE_ITEM_BATCH_SIZE=50
SHOPEE_SYNC_TRANSACTION_TIMEOUT_MS=120000
SHOPEE_RAW_PAYLOAD_LOG_ENABLED=false

# Criptografia de token — gerar com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Anthropic (auditoria via IA) — Sprint 4
